ring R=0,(x1,x2,x3,x4),dp;
ideal I=
(1)*x1^3 + (1)*x2^1*x3^1*x4^1 + (-1)*x3^1*x4^2,
(1)*x1^2*x3^1 + (-1)*x1^1*x3^2 + (1)*x2^3,
(1)*x2^3 + (1)*x3^3,
(-1)*x2^2*x3^1*x4^1 + (1)*x4^4,
(1)*x1^2*x2^2*x3^3*x4^1 + (1)*x1^1*x2^1*x3^2*x4^4,
(2)*x1^5*x4^1 + (-2)*x1^2*x2^4 + (2)*x1^2*x2^3*x3^1 + (1)*x1^2*x2^1*x3^3 + (-1)*x1^2*x2^1*x3^2*x4^1 + (2)*x1^2*x3^3*x4^1 + (1)*x1^1*x2^4*x3^1 + (-2)*x1^1*x2^1*x3^4 + (1)*x1^1*x2^1*x3^3*x4^1 + (-1)*x1^1*x2^1*x4^4 + (-1)*x1^1*x3^3*x4^2 + (-1)*x1^1*x3^1*x4^4 + (-1)*x2^4*x4^2 + (-2)*x2^2*x3^2*x4^2 + (-1)*x2^1*x3^4*x4^1 + (-2)*x2^1*x3^3*x4^2 + (-1)*x2^1*x4^5,
(1)*x2^1*x3^4,
(-2)*x1^3*x2^1*x3^1 + (1)*x1^2*x2^2*x4^1 + (-2)*x1^1*x2^2*x3^1*x4^1 + (2)*x1^1*x2^1*x3^1*x4^2 + (1)*x1^1*x3^4 + (1)*x1^1*x3^3*x4^1 + (-2)*x1^1*x3^1*x4^3 + (-2)*x2^1*x3^1*x4^3 + (2)*x3^5 + (-2)*x4^5,
(1)*x1^1*x3^1*x4^2 + (1)*x4^4;
resolution r=mres(I,0);
print(betti(r),"betti");
resolution r2=sres(std(I),0);
print(betti(r2),"betti");
quit;
